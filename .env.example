# Copy to .env, replace the placeholders, then run:
#   set -a; source .env; set +a

# Matching reference build used to create the candidate manifest.
TISIAGO_GENOME=/absolute/path/to/reference.genome.fa
TISIAGO_GTF=/absolute/path/to/annotation.gtf

# Local AlphaGenome checkpoint downloaded after obtaining model access.
ALPHAGENOME_WEIGHTS_PATH=/absolute/path/to/alphagenome-all-folds

# Optional: large stores and model downloads can live on scratch storage.
# TISIAGO_DENSE_STORE=/absolute/path/to/dense_ag7
# HF_HOME=/absolute/path/to/huggingface-cache
# UV_CACHE_DIR=/absolute/path/to/uv-cache

# Optional Slurm site settings used by scripts/run_tis_pipeline.sh.
# TISIAGO_AG_PARTITION=gpu-partition
# TISIAGO_EVO_PARTITION=gpu-partition
# TISIAGO_CPU_PARTITION=cpu-partition
# TISIAGO_AG_CONCURRENCY=3
# TISIAGO_EVO_CONCURRENCY=2
# TISIAGO_TORCH_BACKEND=cu126

# Optional non-default environment locations.
# TISIAGO_AG_PYTHON=/absolute/path/to/alphagenome/bin/python
# TISIAGO_EVO_PYTHON=/absolute/path/to/evo2/bin/python
# TISIAGO_CPU_PYTHON=/absolute/path/to/evaluation/bin/python
